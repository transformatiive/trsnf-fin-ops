# All credentials below are fetched automatically from the Transformatiive
# credential vault on server start. Only set them here if you want to override
# the vault value (env vars take precedence over vault on first load).
#
# The vault endpoint is:
#   https://trnsf.up.railway.app/webhook/credential-vault?action=get&epic_key=TRNSF-INTERNAL
# Override via CREDENTIAL_VAULT_URL / CREDENTIAL_VAULT_EPIC if needed.

# Optional vault overrides
# CREDENTIAL_VAULT_URL=
# CREDENTIAL_VAULT_EPIC=TRNSF-INTERNAL

# Optional — set only to override what the vault provides
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ORG_ID=
# PARTNER_EU_EMAIL=
# PARTNER_EU_PASSWORD=
# PARTNER_COM_EMAIL=
# PARTNER_COM_PASSWORD=
# MOLONI_CLIENT_ID=
# MOLONI_CLIENT_SECRET=
# MOLONI_USERNAME=
# MOLONI_PASSWORD=
# MOLONI_COMPANY_ID=
# ANTHROPIC_API_KEY=
# ACCESS_TOKEN=          # URL access token (default baked in server/index.js)

# App
PORT=3000
