{
  "name": "transformatiive-dashboard",
  "version": "1.0.0",
  "description": "Transformatiive Financial Operations Dashboard",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"node server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node server/index.js",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
